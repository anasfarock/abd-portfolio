<button id="backToTop" class="back-to-top" aria-label="Back to top">
  <span class="back-to-top-icon">&uarr;</span>
</button>

<script>
  const backToTop = document.getElementById("backToTop");

  window.addEventListener(
    "scroll",
    () => {
      if (backToTop) {
        backToTop.classList.toggle("visible", window.pageYOffset > 300);
      }
    },
    { passive: true }
  );

  backToTop?.addEventListener("click", () => {
    window.scrollTo({ top: 0, behavior: "smooth" });
  });

  document.addEventListener("DOMContentLoaded", () => {
    const chars = document.querySelectorAll(".name-char");
    chars.forEach((char, i) => {
      (char as HTMLElement).style.animationDelay = `${i * 0.06}s`;
      char.classList.add("fade-in");
    });

    // Particle Wave Animation
    const canvas = document.getElementById("particle-wave") as HTMLCanvasElement;
    if (!canvas) return;
    const ctx = canvas.getContext("2d");
    if (!ctx) return;

    let width: number, height: number;
    const resize = () => {
      width = canvas.parentElement?.clientWidth || 600;
      height = canvas.parentElement?.clientHeight || 400;
      const dpr = window.devicePixelRatio || 1;
      canvas.width = width * dpr;
      canvas.height = height * dpr;
      ctx.scale(dpr, dpr);
    };
    window.addEventListener("resize", resize);
    resize();

    let time = 0;
    const draw = () => {
      ctx.clearRect(0, 0, width, height);
      
      const accentColor = getComputedStyle(document.documentElement)
        .getPropertyValue('--accent-color').trim() || '#3b82f6';
      ctx.fillStyle = accentColor;
      
      const cols = 35;
      const rows = 35;
      const spacing = 40;
      
      for (let z = 0; z < rows; z++) {
        for (let x = 0; x < cols; x++) {
          const px = (x - cols / 2) * spacing;
          const pz = (z - rows / 2) * spacing;
          
          // 3D rolling ocean wave calculation
          const py = Math.sin(px * 0.015 + time) * 35 + 
                     Math.sin(pz * 0.015 + time) * 35;
          
          // Perspective projection
          const focalLength = 400;
          const cameraZ = 700;
          const adjustedZ = pz + cameraZ; 
          
          if (adjustedZ <= 0) continue;
          
          const scale = focalLength / adjustedZ;
          const screenX = width / 2 + px * scale;
          const screenY = height / 2 + py * scale + (pz * 0.4 * scale);
          
          const size = Math.max(0.5, 1.8 * scale);
          const alpha = Math.min(1, Math.max(0.05, scale * 1.5 - 0.3));
          
          // Culling off-screen particles for performance
          if (screenX > -10 && screenX < width + 10 && screenY > -10 && screenY < height + 10) {
            ctx.globalAlpha = alpha;
            ctx.beginPath();
            ctx.arc(screenX, screenY, size, 0, Math.PI * 2);
            ctx.fill();
          }
        }
      }
      
      time += 0.02;
      requestAnimationFrame(draw);
    };
    draw();
  });
</script>

